# =========================
# Core Discord
# =========================
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_DISCORD_ID=
TEST_GUILD_ID=

# =========================
# Channels / roles
# =========================
LOG_CHANNEL_ID=
PANEL_CHANNEL_ID=
ADMIN_ROLE_ID=

# =========================
# App runtime
# =========================
NODE_ENV=production
PORT=3000

# Database
# Runtime uses MySQL. MONGO_URL is only needed temporarily for migration.
DATABASE_URL=
MONGO_URL=

# FS25 telemetry via FTP (single server, or use FS25_SERVERS for multi)
FS25_FTP_HOST=
FS25_FTP_USER=
FS25_FTP_PASS=
FS25_FTP_REMOTE_PATH=/profile/modSettings/FarmBuddyTelemetry/telemetry_latest.json
FS25_FTP_SECURE=false
FS25_FTP_PORT=
FS25_FTP_POLL_MS=3000
FS25_SERVER_ID=gportal
FS25_FTP_DEBUG=false

# Multi-server config (JSON array, overrides individual FS25_FTP_* vars)
# FS25_SERVERS=[{"id":"sr","name":"Slavonska Ravnica","host":"1.2.3.4","user":"u","pass":"p","port":21,"remotePath":"/profile/modSettings/FS25_FSG_Companion/commands/outbox","statsUrl":"http://host:8140/feed/dedicated-server-stats.xml?code=XXX","modsUrl":"http://host:8140/mods.html","mapImageUrl":"http://host:8140/feed/dedicated-server-stats-map.jpg?code=XXX&quality=60&size=512"}]

# Web Stats SDK (optional fallback, used if no statsUrl/modsUrl in FS25_SERVERS)
WEBSTATS_STATS_XML_URL=
WEBSTATS_MAP_IMAGE_URL=
WEBSTATS_MODS_URL=
# Optional outbound webhook push (dashboard -> your web)
WEB_PUSH_URL=
WEB_PUSH_TOKEN=
WEB_PUSH_ENABLED=false
WEB_PUSH_TIMEOUT_MS=4000
# Optional savegame HTML sources (advanced)
WEBSTATS_SAVEGAME_CAREER_URL=
WEBSTATS_SAVEGAME_VEHICLES_URL=
WEBSTATS_SAVEGAME_ECONOMY_URL=

# Optional map bounds (tracking visuals)
MAP_MIN_X=
MAP_MAX_X=
MAP_MIN_Z=
MAP_MAX_Z=
