<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="roller.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.6"/>
  </Asset>

  <Files>
    <File fileId="5" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="2" filename="$data/shared/default_diffuse.dds"/>
    <File fileId="8" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png"/>
    <File fileId="7" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png"/>
    <File fileId="6" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png"/>
    <File fileId="14" filename="$data/shared/detailLibrary/flat_normal.png"/>
    <File fileId="15" filename="$data/shared/detailLibrary/metallic/silverScratched_diffuse.png"/>
    <File fileId="13" filename="$data/shared/detailLibrary/metallic/silverScratched_specular.png"/>
    <File fileId="18" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_diffuse.png"/>
    <File fileId="17" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_normal.png"/>
    <File fileId="16" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_specular.png"/>
    <File fileId="4" filename="textures/roller_Vmask.dds"/>
    <File fileId="3" filename="textures/roller_normal.dds"/>
  </Files>


  <Materials>
    <Material name="default" materialId="5" diffuseColor="0.501961 0.501961 0.501961 1">
    </Material>
    <Material name="r_calibratedPaintMat" materialId="6" customShaderId="5">
      <Texture fileId="2"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
      <Custommap name="detailSpecular" fileId="6"/>
      <Custommap name="detailNormal" fileId="7"/>
      <Custommap name="detailDiffuse" fileId="8"/>
      <CustomParameter name="colorScale" value="0.0324 0.0408 0.0506"/>
      <CustomParameter name="smoothnessScale" value="0.85"/>
      <CustomParameter name="clearCoatIntensity" value="0.1"/>
      <CustomParameter name="clearCoatSmoothness" value="0.2"/>
    </Material>
    <Material name="r_redrubberMat" materialId="7" customShaderId="5">
      <Texture fileId="2"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
      <Custommap name="detailSpecular" fileId="16"/>
      <Custommap name="detailNormal" fileId="17"/>
      <Custommap name="detailDiffuse" fileId="18"/>
      <CustomParameter name="colorScale" value="1 0 0"/>
      <CustomParameter name="porosity" value="0.5"/>
    </Material>
    <Material name="r_silverScratchedMat" materialId="8" customShaderId="5">
      <Texture fileId="2"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
      <Custommap name="detailSpecular" fileId="13"/>
      <Custommap name="detailNormal" fileId="14"/>
      <Custommap name="detailDiffuse" fileId="15"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="roller.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="rollercol" shapeId="1" dynamic="true" compound="true" collisionFilterGroup="0x10004" collisionFilterMask="0xfe3ffb83" clipDistance="300" nodeId="16" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="5">
      <Shape name="frame" translation="0 0.722355 0" shapeId="2" clipDistance="300" nodeId="17" castsShadows="true" receiveShadows="true" materialIds="6,8">
        <Shape name="hitchcol" translation="0 -0.722355 0" shapeId="3" compoundChild="true" collisionFilterGroup="0x10004" collisionFilterMask="0xfe3ffb83" density="0.001" nodeId="18" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="5"/>
        <Shape name="hitchpin" translation="1.0122e-06 0.374375 2.59913" shapeId="4" clipDistance="300" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="8,7">
          <TransformGroup name="attacherJoint" rotation="-0 90 0" clipDistance="300" nodeId="20"/>
        </Shape>
        <Shape name="rollerframe" translation="0 -0.05 0" shapeId="5" clipDistance="300" nodeId="21" castsShadows="true" receiveShadows="true" materialIds="6,8">
          <Shape name="roller" shapeId="6" clipDistance="300" nodeId="22" castsShadows="true" receiveShadows="true" materialIds="6,8"/>
          <TransformGroup name="rollerwheel" translation="0 0.05 0" clipDistance="300" nodeId="23"/>
        </Shape>
        <TransformGroup name="rollerwheel" clipDistance="300" nodeId="24"/>
        <TransformGroup name="wheelLeft" translation="1.4724 -0.331124 0.125097" clipDistance="300" nodeId="25"/>
        <TransformGroup name="wheelRight" translation="-1.4724 -0.331124 0.125098" clipDistance="300" nodeId="26"/>
      </Shape>
      <TransformGroup name="heightNode" translation="0 0.2 0" nodeId="27"/>
    </Shape>
  </Scene>

</i3D>
