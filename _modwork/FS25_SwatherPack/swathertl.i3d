<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="swathertl.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.6"/>
  </Asset>

  <Files>
    <File fileId="4" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="1" filename="$data/shared/default_diffuse.dds"/>
    <File fileId="7" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png"/>
    <File fileId="6" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png"/>
    <File fileId="5" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png"/>
    <File fileId="13" filename="$data/shared/detailLibrary/flat_normal.png"/>
    <File fileId="16" filename="$data/shared/detailLibrary/metallic/clear_diffuse.png"/>
    <File fileId="15" filename="$data/shared/detailLibrary/metallic/clear_specular.png"/>
    <File fileId="14" filename="$data/shared/detailLibrary/metallic/silverScratched_diffuse.png"/>
    <File fileId="12" filename="$data/shared/detailLibrary/metallic/silverScratched_specular.png"/>
    <File fileId="2" filename="textures/swather_normal.png"/>
    <File fileId="3" filename="textures/swather_vMask.png"/>
  </Files>


  <Materials>
    <Material name="s_calibratedPaintMat" materialId="5" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="detailSpecular" fileId="5"/>
      <Custommap name="detailNormal" fileId="6"/>
      <Custommap name="detailDiffuse" fileId="7"/>
      <CustomParameter name="colorScale" value="0.012 0.012 0.012"/>
      <CustomParameter name="smoothnessScale" value="0.85"/>
      <CustomParameter name="clearCoatIntensity" value="0.1"/>
      <CustomParameter name="clearCoatSmoothness" value="0.2"/>
    </Material>
    <Material name="s_chromeMat" materialId="6" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="detailSpecular" fileId="15"/>
      <Custommap name="detailNormal" fileId="13"/>
      <Custommap name="detailDiffuse" fileId="16"/>
    </Material>
    <Material name="s_silverScratchedMat" materialId="7" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="detailSpecular" fileId="12"/>
      <Custommap name="detailNormal" fileId="13"/>
      <Custommap name="detailDiffuse" fileId="14"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="swathertl.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="cylinder3" rotation="-1.29066e-32 4.29391e-16 -1.72219e-15" shapeId="1" clipDistance="100" nodeId="11" castsShadows="true" receiveShadows="true" materialIds="5,7">
      <Shape name="cylinder3punch" shapeId="2" nodeId="12" castsShadows="true" receiveShadows="true" materialIds="5,6,7">
        <TransformGroup name="referencePoint" translation="0 0 0.85" nodeId="13"/>
      </Shape>
      <TransformGroup name="scalePartRef" translation="0 0 0.85" nodeId="14">
        <TransformGroup name="scalePartRef" translation="0 0 0.2" nodeId="15"/>
      </TransformGroup>
    </Shape>
  </Scene>

</i3D>
