<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="lizardWheel.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.6"/>
  </Asset>

  <Files>
    <File fileId="13" filename="$data/shaders/tireMudShader.xml"/>
    <File fileId="4" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="1" filename="$data/shared/default_diffuse.dds"/>
    <File fileId="18" filename="$data/shared/detailLibrary/flat_normal.png"/>
    <File fileId="19" filename="$data/shared/detailLibrary/metallic/silverScratched_diffuse.png"/>
    <File fileId="17" filename="$data/shared/detailLibrary/metallic/silverScratched_specular.png"/>
    <File fileId="10" filename="$data/shared/detailLibrary/nonMetallic/dirt_diffuse.png"/>
    <File fileId="8" filename="$data/shared/detailLibrary/nonMetallic/dirt_specular.png"/>
    <File fileId="12" filename="$data/shared/detailLibrary/nonMetallic/mud_normal.png"/>
    <File fileId="7" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubberBlack_diffuse.png"/>
    <File fileId="6" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_normal.png"/>
    <File fileId="5" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_specular.png"/>
    <File fileId="15" filename="$data/shared/wheels/rims/implement/rim004_normal.png"/>
    <File fileId="16" filename="$data/shared/wheels/rims/implement/rim004_vmask.png"/>
    <File fileId="14" filename="$data/shared/white_diffuse.png"/>
    <File fileId="3" filename="tire_Vmask.png"/>
    <File fileId="2" filename="tire_normal.png"/>
  </Files>


  <Materials>
    <Material name="Default OBJ_rubberBlack" materialId="5" customShaderId="4" customShaderVariation="tirePressureDeformation">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="detailSpecular" fileId="5"/>
      <Custommap name="detailNormal" fileId="6"/>
      <Custommap name="detailDiffuse" fileId="7"/>
      <CustomParameter name="porosity" value="0.5"/>
      <CustomParameter name="morphPos" value="-0.4 -0.8 0 0.1"/>
    </Material>
    <Material name="mud_mat" materialId="6" customShaderId="13">
      <Texture fileId="10"/>
      <Normalmap fileId="12"/>
      <Glossmap fileId="8"/>
      <CustomParameter name="morphPos" value="-0.4 -0.8 0 0.1"/>
    </Material>
    <Material name="rim_inner_mat" materialId="7" customShaderId="4">
      <Texture fileId="14"/>
      <Normalmap fileId="15"/>
      <Glossmap fileId="16"/>
      <Custommap name="detailSpecular" fileId="17"/>
      <Custommap name="detailNormal" fileId="18"/>
      <Custommap name="detailDiffuse" fileId="19"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="lizardWheel.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="turf" shapeId="1" clipDistance="300" nodeId="14" castsShadows="true" receiveShadows="true" materialIds="5">
      <Shape name="mudMesh" scale="0.571881 0.601 0.601" shapeId="2" clipDistance="35" nodeId="15" castsShadows="true" receiveShadows="true" materialIds="6"/>
    </Shape>
    <Shape name="turf2" shapeId="3" clipDistance="300" nodeId="16" castsShadows="true" receiveShadows="true" materialIds="5">
      <Shape name="mudMesh" scale="0.616578 0.691 0.691" shapeId="2" clipDistance="35" nodeId="17" castsShadows="true" receiveShadows="true" materialIds="6"/>
    </Shape>
    <TransformGroup name="innerDiscPart" clipDistance="300" nodeId="18">
      <Shape name="lod0" shapeId="4" clipDistance="300" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="7"/>
      <Shape name="lod0" shapeId="5" clipDistance="300" nodeId="20" castsShadows="true" receiveShadows="true" materialIds="7"/>
    </TransformGroup>
  </Scene>

</i3D>
